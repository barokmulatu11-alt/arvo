generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  resumes             Resume[]
  subscription        Subscription?
  passwordResetTokens PasswordResetToken[]
  paymentRequests     PaymentRequest[]
}

model PaymentRequest {
  id             String    @id @default(uuid())
  userId         String
  method         String    // "TELEBIRR" | "CBE"
  screenshotData String    // base64 encoded image
  screenshotType String    @default("image/jpeg")
  amount         Int       @default(199)
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote      String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id         String   @id @default(uuid())
  userId     String
  title      String   @default("Untitled Resume")
  templateId String   @default("modern")
  content    String   @default("{}")  // JSON string matching ResumeContentSchema
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id           String   @id @default(uuid())
  userId       String   @unique
  plan         String   @default("FREE") // FREE | PRO
  status       String   @default("ACTIVE") // ACTIVE | CANCELED | PAST_DUE
  aiUsageCount Int      @default(0)
  resetDate    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
